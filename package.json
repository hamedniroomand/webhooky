{
  "name": "webhooky",
  "version": "0.1.0",
  "private": true,
  "description": "A temporary webhook inbox with a live request inspector.",
  "keywords": [
    "bun",
    "react",
    "sqlite",
    "sse",
    "webhook",
    "webhook-inspector"
  ],
  "homepage": "https://github.com/hamedniroomand/webhooky#readme",
  "bugs": {
    "url": "https://github.com/hamedniroomand/webhooky/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/webhooky.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format:check": "oxfmt --check",
    "format": "oxfmt .",
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "lint-staged": {
    "*": "bun run lint:fix"
  },
  "packageManager": "bun@1.4.2"
}
